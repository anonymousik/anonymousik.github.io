#!/usr/bin/env python3
"""
titanium_brain_monkey_patch.py
Patch łączący TitaniumBrain v17.0 z MonkeyEngine v17.1.
Dodaj do końca __init__ klasy TitaniumBrain:
    from titanium_brain_monkey_patch import patch_brain_with_monkey
    patch_brain_with_monkey(self)
"""
from __future__ import annotations
from typing import Any
import time

def patch_brain_with_monkey(brain: Any) -> None:
    """
    Wstrzykuje MonkeyOrchestrator do instancji TitaniumBrain.
    Rozszerza menu o sekcję MONKEY UI AUTOMATION.
    """
    try:
        from titanium_monkey import MonkeyOrchestrator, MonkeyServer, Key
    except ImportError:
        print("  [MonkeyPatch] titanium_monkey.py not found — skipping")
        return

    device = brain.device
    mo     = MonkeyOrchestrator(device)
    brain._monkey = mo

    # ── Nowe pozycje menu ───────────────────────────────────────────────────
    def _monkey_menu() -> None:
        from titanium_monkey import (
            MonkeyOrchestrator, MonkeyServer, Key,
            TVRemoteController, MonkeyHealthCheck,
            SmartTubeNavigator, MonkeyWatcher
        )

        C_ = lambda k: {"s":"\033[92m","w":"\033[93m","e":"\033[91m",
                         "c":"\033[96m","h":"\033[95m","r":"\033[0m"}.get(k,"")
        import os

        while True:
            os.system("clear")
            print(f"""
{C_('h')}+-- MONKEY ENGINE v17.1 -- @devicefarmer/adbkit-monkey protocol --+{C_('r')}
  {C_('c')}M1.{C_('r')}  Health Check (display, latency, SDK, foreground app)
  {C_('c')}M2.{C_('r')}  SmartTube auto-config (VP9 + tunnel + 1080p via UI)
  {C_('c')}M3.{C_('r')}  Watch UI (real-time foreground app + latency monitor)
  {C_('c')}M4.{C_('r')}  Interactive Remote (WASD/HJKL pilot TV in terminal)
  {C_('c')}M5.{C_('r')}  Wake device
  {C_('c')}M6.{C_('r')}  Device info via monkey variables
  {C_('c')}M7.{C_('r')}  Key press (enter keycode)
  {C_('c')}M8.{C_('r')}  Tap coordinate (x y)
  {C_('c')}M9.{C_('r')}  Swipe gesture (x1 y1 x2 y2)
  {C_('c')}M10.{C_('r')} Navigate SmartTube (path string e.g. UUDOB)
  {C_('c')}M11.{C_('r')} Start monkey server only
  {C_('c')}M12.{C_('r')} Stop monkey server
  {C_('c')}M0.{C_('r')}  Back to main menu
""")
            try:
                ch = input(f"  {C_('c')}Monkey > {C_('r')}").strip().lower()
            except (EOFError, KeyboardInterrupt):
                break

            if   ch in ("m0", "0"): break
            elif ch == "m1":
                mo.health_check()
            elif ch == "m2":
                mo.auto_config_smarttube()
            elif ch == "m3":
                try:
                    dur = int(input("  Duration [s, default=60]: ").strip() or "60")
                except ValueError:
                    dur = 60
                mo.watch_ui(duration_s=dur)
            elif ch == "m4":
                mo.interactive()
            elif ch == "m5":
                mo.wake_device()
            elif ch == "m6":
                info = mo.read_device_info()
                for k, v in info.items():
                    if k != "all_vars":
                        print(f"  {k:<22}: {v}")
                if "all_vars" in info:
                    print(f"  variables:             {len(info['all_vars'])}")
                    print("  ", ", ".join(info["all_vars"][:10]), "...")
            elif ch == "m7":
                try:
                    kc  = int(input("  Keycode (e.g. 3=HOME, 4=BACK, 23=OK): ").strip())
                    lng = input("  Long press? [y/N]: ").strip().lower() == "y"
                    mo.press_key(kc, long=lng)
                    print(f"  Sent keycode {kc} ({'long' if lng else 'short'})")
                except ValueError:
                    print("  Invalid keycode")
            elif ch == "m8":
                try:
                    x, y = map(int, input("  x y (e.g. 960 540): ").split())
                    ok = mo.tap_coordinate(x, y)
                    print(f"  Tap ({x},{y}): {'OK' if ok else 'FAILED'}")
                except (ValueError, TypeError):
                    print("  Invalid coordinates")
            elif ch == "m9":
                try:
                    coords = list(map(int, input("  x1 y1 x2 y2: ").split()))
                    if len(coords) == 4:
                        ok = mo.swipe_gesture(*coords)
                        print(f"  Swipe: {'OK' if ok else 'FAILED'}")
                except (ValueError, TypeError):
                    print("  Invalid coordinates")
            elif ch == "m10":
                path = input(
                    "  Navigation path (U=up D=down L=left R=right O=ok B=back M=menu H=home): "
                ).strip().upper()
                if path:
                    ok = mo.navigate_smarttube(path)
                    print(f"  Navigate '{path}': {'OK' if ok else 'FAILED'}")
            elif ch == "m11":
                print("  Starting monkey server...")
                ok = MonkeyServer.start(device)
                print(f"  Monkey server: {'started ✓' if ok else 'FAILED'}")
            elif ch == "m12":
                MonkeyServer.stop(device)
                print("  Monkey server stopped")
            else:
                print(f"  Unknown: '{ch}'")

            try:
                input(f"\n  {C_('c')}Enter to continue...{C_('r')}")
            except (EOFError, KeyboardInterrupt):
                pass

    # Wstrzyknij do głównego menu jako opcję 'M'
    brain._monkey_menu = _monkey_menu

    # Dodaj integrację do WatchdogDaemon
    _patch_watchdog_monkey(brain, mo)

    print("  [MonkeyPatch] MonkeyEngine v17.1 integrated ✓")
    print(f"  [MonkeyPatch] Use option 'M' in main menu for UI automation")


def _patch_watchdog_monkey(brain: Any, mo: "MonkeyOrchestrator") -> None:
    """
    Rozszerza WatchdogDaemon o monkey-based UI checks.
    Sprawdza czy SmartTube jest foreground podczas odtwarzania.
    """
    try:
        from titanium_monkey import MonkeyServer, MonkeyClient, MonkeyProtocolError
        from titanium_brain import WatchdogDaemon
    except ImportError:
        return

    orig_cycle = WatchdogDaemon._cycle.__func__

    @classmethod  # type: ignore[misc]
    def patched_cycle(cls) -> None:
        orig_cycle(cls)

        # Monkey-based: sprawdź foreground app (raz na 5 cyklach)
        if not hasattr(cls, "_monkey_cycle_count"):
            cls._monkey_cycle_count = 0
        cls._monkey_cycle_count += 1
        if cls._monkey_cycle_count % 5 != 0:
            return

        try:
            device = brain.device
            if not MonkeyServer.start(device):
                return
            client = MonkeyClient()
            if not client.connect(timeout=3.0):
                return
            pkg = client.get_current_package()
            client.done()
            client.disconnect()

            if pkg and "smarttube" in pkg.lower():
                # SmartTube is foreground — verify activity
                pass
            elif pkg and pkg not in ("", None):
                ts = time.strftime("%H:%M:%S")
                cls._alerts.append(
                    (ts, f"Monkey: foreground={pkg} (SmartTube not active)")
                )
        except Exception:
            pass

    try:
        WatchdogDaemon._cycle = patched_cycle
    except (AttributeError, TypeError):
        pass