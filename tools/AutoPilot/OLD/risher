#!/system/bin/sh
# ==============================================================================
# SECFERRO - ADAPTIVE SHIZUKU WRAPPER (AutoPilot v2.0 - Dynamic DEX Extraction)
# ==============================================================================
# Wektor: Dynamiczna detekcja pakietu, ekstrakcja bazowego APK jako Payloadu,
# ustawianie uprawnień, auto-launch, pro-diagnoza.
# ==============================================================================

export RISH_APPLICATION_ID="com.android.shell"
DEX_TARGET="/data/local/tmp/rish_shizuku.dex"

# --- ZASADY KOMUNIKACYJNE ---
log_info() { echo "\033[1;34m[INFO]\033[0m $1"; }
log_ok()   { echo "\033[1;32m[ OK ]\033[0m $1"; }
log_warn() { echo "\033[1;33m[WARN]\033[0m $1"; }
log_crit() { echo "\033[1;31m[CRITICAL]\033[0m $1"; }

# --- DYNAMICZNA DETEKCJA PAKIETU ---
get_shizuku_pkg() {
    # Szukamy pakietu ignorując wielkość liter, wycinamy nazwę
    pm list packages | grep -i "shiz" | cut -d':' -f2 | head -n 1
}

# --- FAZA DIAGNOSTYCZNA (Pro-Diagnostic) ---
diag_system() {
    log_info "Inicjalizacja testu diagnostycznego SecFERRO v2..."
    
    PKG_NAME=$(get_shizuku_pkg)
    if [ -n "$PKG_NAME" ]; then
        log_ok "Aplikacja znaleziona: $PKG_NAME"
        APP_PATH=$(pm path "$PKG_NAME" | cut -d':' -f2 | grep "base.apk" | head -n 1)
        if [ -n "$APP_PATH" ]; then
            log_ok "Lokalizacja binarna (APK): $APP_PATH"
        else
            log_crit "Pakiet zainstalowany, ale brak dostępu do base.apk!"
        fi
    else
        log_crit "Aplikacja Shizuku NIE JEST ZAINSTALOWANA."
    fi

    SERVER_PID=$(pidof shizuku_server)
    if [ -n "$SERVER_PID" ]; then
        log_ok "Demon shizuku_server JEST AKTYWNY (PID: $SERVER_PID)"
    else
        log_warn "Demon shizuku_server NIE DZIAŁA. System wymaga eskalacji start.sh."
    fi
}

# --- FAZA EKSTRAKCJI I AUTO-NAPRAWY (Dynamic Extraction) ---
ensure_dex() {
    if [ -f "$DEX_TARGET" ]; then
        return 0
    fi
    
    log_warn "Brak pliku środowiskowego ($DEX_TARGET). Inicjalizacja procedury ekstrakcji..."
    
    # KROK 1: Detekcja pakietu
    PKG_NAME=$(get_shizuku_pkg)
    if [ -z "$PKG_NAME" ]; then
        log_crit "Nie znaleziono pakietu systemowego Shizuku. Przerywam operację."
        exit 1
    fi
    log_info "Ustalono nazwę pakietu: $PKG_NAME"

    # KROK 2: Detekcja ścieżki
    APK_PATH=$(pm path "$PKG_NAME" | cut -d':' -f2 | grep "base.apk" | head -n 1)
    if [ -z "$APK_PATH" ]; then
        log_crit "Nie można odczytać ścieżki do pliku APK instalacji."
        exit 1
    fi
    log_info "Namierzono Payload: $APK_PATH"

    # KROK 3: Ekstrakcja i propagacja uprawnień
    log_info "Generowanie natywnego Payloadu DEX z pliku instalacyjnego..."
    cp "$APK_PATH" "$DEX_TARGET"
    
    if [ $? -eq 0 ]; then
        chmod 755 "$DEX_TARGET"
        log_ok "Payload DEX wygenerowany i zabezpieczony (Chmod 755)."
    else
        log_crit "Błąd kopiowania Payloadu (Brak uprawnień do /data/local/tmp/)."
        exit 1
    fi
}

# --- GENERACJA LAUNCHERA (Auto-Launch) ---
launch_shizuku_server() {
    if [ -n "$(pidof shizuku_server)" ]; then
        return 0
    fi

    PKG_NAME=$(get_shizuku_pkg)
    [ -z "$PKG_NAME" ] && return 1

    log_warn "Demon nie odpowiada. Inicjalizacja środowiska startowego Shizuku..."
    
    # Skrypt Scope Storage Androida 11+
    START_SCRIPT="/storage/emulated/0/Android/data/${PKG_NAME}/start.sh"
    
    if [ -f "$START_SCRIPT" ]; then
        log_info "Wykryto skrypt systemowy. Uruchamianie..."
        sh "$START_SCRIPT"
        sleep 2
    else
        log_info "Wymuszanie wzbudzenia przez Activity Managera (Intent Auth Request)..."
        am broadcast -a ${PKG_NAME}.intent.action.AUTH_REQUEST 1>/dev/null 2>&1
        sleep 2
    fi

    if [ -z "$(pidof shizuku_server)" ]; then
        log_crit "Auto-Launch nie powiódł się. Sprawdź etykiety SELinux dla adbd (u:r:su:s0)."
        exit 1
    fi
}

# --- WEKTOR WYKONAWCZY (Main Execution) ---
if [ "$1" = "--diag" ]; then
    diag_system
    exit 0
fi

# 1. Zapewnij integralność środowiska (kolejność ma znaczenie)
launch_shizuku_server
ensure_dex

# 2. Eskalacja komendy do warstwy Javy (Dalvik/ART)
if [ "$1" = "-c" ]; then
    shift
    CMD="$*"
    exec /system/bin/app_process -Djava.class.path="$DEX_TARGET" /system/bin --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader -c "$CMD"
else
    exec /system/bin/app_process -Djava.class.path="$DEX_TARGET" /system/bin --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@"
fi